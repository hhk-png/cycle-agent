# Copy to .env and replace every default before exposing the service.
MLFLOW_VERSION=3.18.0
MLFLOW_WORKERS=2
MLFLOW_BUCKET=mlflow

POSTGRES_USER=mlflow
# Keep this URL-safe (letters/digits); it is interpolated into the
# postgresql:// URI.  URL-encode reserved characters if you must use them.
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=mlflow

MINIO_ROOT_USER=mlflow-artifacts
MINIO_ROOT_PASSWORD=replace-with-a-long-random-value

MLFLOW_HTTP_PORT=8080
MLFLOW_HTTPS_PORT=8443

# Pin these before production.
MINIO_VERSION=latest
MINIO_MC_VERSION=latest
