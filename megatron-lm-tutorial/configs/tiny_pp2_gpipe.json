{
  "model": {
    "vocab_size": 128,
    "max_seq_len": 64,
    "hidden_size": 64,
    "num_layers": 2,
    "num_attention_heads": 4,
    "num_query_groups": 4,
    "ffn_hidden_size": 128,
    "activation": "swiglu",
    "position_embedding": "rope"
  },
  "parallel": {
    "tensor_model_parallel_size": 1,
    "pipeline_model_parallel_size": 2,
    "context_parallel_size": 1,
    "sequence_parallel": false,
    "pipeline_schedule": "gpipe"
  },
  "train": {
    "micro_batch_size": 2,
    "global_batch_size": 4,
    "seq_len": 32,
    "max_steps": 4,
    "lr": 0.0003,
    "warmup_steps": 1,
    "checkpoint_dir": "checkpoints/tiny_pp2_gpipe",
    "device": "cpu",
    "data": "synthetic",
    "seed": 1234
  }
}